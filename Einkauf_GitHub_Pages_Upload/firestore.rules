rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(listId) {
      return signed() && get(/databases/$(database)/documents/sharedLists/$(listId)).data.ownerUid == request.auth.uid;
    }
    function member(listId) {
      return signed() && exists(/databases/$(database)/documents/sharedLists/$(listId)/members/$(request.auth.uid));
    }
    function canUse(listId) { return owner(listId) || member(listId); }
    function validItem(d) {
      return d.keys().hasOnly(['text','amount','done','updatedAt']) &&
        d.keys().hasAll(['text','amount','done','updatedAt']) &&
        d.text is string && d.text.size() > 0 && d.text.size() <= 140 &&
        d.amount is string && d.amount.size() <= 100 &&
        d.done is bool && d.updatedAt is number;
    }
    match /sharedLists/{listId} {
      allow create: if signed() &&
        request.resource.data.keys().hasOnly(['name','store','ownerUid','createdAt']) &&
        request.resource.data.keys().hasAll(['name','store','ownerUid','createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() <= 70 &&
        request.resource.data.store is string && request.resource.data.store.size() <= 60 &&
        request.resource.data.createdAt == request.time;
      allow get, list: if signed() && (resource.data.ownerUid == request.auth.uid || member(listId));
      allow update: if signed() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','store']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 70 &&
        request.resource.data.store is string && request.resource.data.store.size() <= 60;
      allow delete: if false;

      match /items/{itemId} {
        allow get, list: if canUse(listId);
        allow create, update: if canUse(listId) && validItem(request.resource.data);
        allow delete: if canUse(listId);
      }
      match /members/{memberUid} {
        allow get, list: if signed() && (owner(listId) || memberUid == request.auth.uid);
        allow create: if signed() && memberUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId','inviteId','joinedAt']) &&
          request.resource.data.keys().hasAll(['userId','inviteId','joinedAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.inviteId is string &&
          request.resource.data.joinedAt == request.time &&
          getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.listId == listId &&
          getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.usedBy == request.auth.uid &&
          request.time < getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.expiresAt;
        allow update: if false;
        allow delete: if signed() && (owner(listId) || memberUid == request.auth.uid);
      }
    }
    match /invites/{inviteId} {
      // IDs are 256-bit random one-time tokens. Cannot list all invitations.
      allow get: if signed();
      allow list: if false;
      allow create: if signed() &&
        request.resource.data.keys().hasOnly(['listId','ownerUid','createdAt','expiresAt','usedBy']) &&
        request.resource.data.keys().hasAll(['listId','ownerUid','createdAt','expiresAt','usedBy']) &&
        request.resource.data.listId is string &&
        request.resource.data.ownerUid == request.auth.uid &&
        owner(request.resource.data.listId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30,'m') &&
        request.resource.data.usedBy == null;
      allow update: if signed() && resource.data.usedBy == null &&
        request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']) &&
        request.resource.data.usedBy == request.auth.uid;
      allow delete: if signed() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
